# Entity: add_currency

main: kit: entity: add_currency: {

  alias: field: {}

  fields: {
    conversionRate: {
      h: "Conversion Rate"
      n: "conversionRate"
      r: true
      sh: "The conversion rate between the to and from currency code of this exchange rate."
      t: "`$NUMBER`"
    }
    createdAt: {
      fo: "date-time"
      h: "Created At"
      n: "createdAt"
      r: true
      sh: "The date the exchange rate was created."
      t: "`$STRING`"
    }
    currencyCode: {
      h: "Currency Code"
      n: "currencyCode"
      r: true
      sh: "The currency code being added to the HubSpot portal for use with central exchange rates."
      t: "`$STRING`"
    }
    effectiveAt: {
      fo: "date-time"
      h: "Effective At"
      n: "effectiveAt"
      r: true
      sh: "The date the exchange rate is in effect."
      t: "`$STRING`"
    }
    fromCurrencyCode: {
      h: "From Currency Code"
      n: "fromCurrencyCode"
      r: true
      sh: "This represents the three-letter currency code (such as USD for US Dollar) of the currency you are converting from."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: true
      sh: "A unique identifier for the exchange rate"
      t: "`$STRING`"
    }
    toCurrencyCode: {
      h: "To Currency Code"
      n: "toCurrencyCode"
      r: true
      sh: "This represents the three-letter currency code (such as USD for US Dollar) of the currency you are converting to."
      t: "`$STRING`"
    }
    updatedAt: {
      fo: "date-time"
      h: "Updated At"
      n: "updatedAt"
      r: true
      sh: "The date the exchange rate was last updated."
      t: "`$STRING`"
    }
    visibleInUI: {
      h: "Visible In Ui"
      n: "visibleInUI"
      r: true
      sh: "This indicates if the exchange rate is shown in the MultiCurrency settings page."
      t: "`$BOOLEAN`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "add_currency"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /settings/currencies/2026-09/central-fx-rates/add-currency"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/settings/currencies/2026-09/central-fx-rates/add-currency"
          s: [
            {
              lit: "settings"
            }
            {
              lit: "currencies"
            }
            {
              lit: "2026-09"
            }
            {
              lit: "central-fx-rates"
            }
            {
              lit: "add-currency"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
